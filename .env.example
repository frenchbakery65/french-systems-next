# Database Postgres. Di Vercel: pasang Neon dari tab Storage/Marketplace, DATABASE_URL terisi otomatis.
# Lokal: jalankan `docker compose up -d db` lalu pakai baris di bawah.
DATABASE_URL=postgres://absensi:absensi@localhost:5432/absensi

# Kunci rahasia (min. 32 karakter) untuk mengenkripsi API token Fingerspot. Buat dengan: openssl rand -base64 32
APP_SECRET=ganti-dengan-kunci-acak-minimal-32-karakter

# Rahasia untuk endpoint cron (Vercel mengirimnya otomatis jika diisi di Project Settings → Environment Variables)
CRON_SECRET=ganti-dengan-kunci-acak

NAMA_PERUSAHAAN=French Bakery
FINGERSPOT_API_URL=https://developer.fingerspot.io

# Admin pertama (dibuat otomatis saat deploy / npm run db:siapkan, HANYA jika belum ada user sama sekali).
# Setelah berhasil login, ADMIN_PASSWORD boleh dihapus.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAMA=
